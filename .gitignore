# Data — all raw downloads, processed HDF5, and simulation variants are
# large and/or reproducible; generate locally. Ignore the whole tree.
# Anchored with a leading slash so it only matches the top-level data/ dir,
# NOT source packages like src/data/.
/data/

# Large binary artifacts (training data, model weights, caches) — never commit
*.h5
*.hdf5
*.pt
*.pth
*.npz
*.npy
*.fits
*.pkl
*.pickle

# Checkpoints (large model files — train locally)
checkpoints/

# Outputs (generated by analysis scripts)
outputs/

# Logs (build/training logs, batch scripts, stale data)
logs/

# SBI tensorboard logs
sbi-logs/

# OS
Thumbs.db
.DS_Store

# Misc
*.log
*.bak

# Project scratch: regeneration/run logs written to the repo root, and the
# temporary commit-message files used to work around PowerShell here-strings.
logs_*.txt
_commitmsg.tmp
*.tmp
